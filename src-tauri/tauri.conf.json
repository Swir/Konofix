{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konofix Chat",
  "version": "0.6.1-rc.1",
  "identifier": "info.swir.konofixchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konofix Chat",
        "width": 1280,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Swir/Konofix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyRjc1NzQ4QjFGQ0Y4NkUKUldSdStQeXhTRmYzb3Rvd2xqVjhxQXNRZmRaSStVMGtVQ3ZUNDMydDRlTmh6MWVhVks5NmJsZGYK"
    }
  }
}
