{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konofix Chat",
  "version": "0.4.2",
  "identifier": "info.swir.konofixchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konofix Chat",
        "width": 1280,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
